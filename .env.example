# ============================================================
# SecondBrain Template — example environment
# Copy to .env and fill in. Never commit .env.
# ============================================================

# --- Telegram ---
# Bot token from @BotFather
SB_TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (from @userinfobot).
# Comma-separated for multiple users.
SB_TELEGRAM_ALLOWED_USER_ID=

# --- Ollama (required) ---
# Default: local instance
SB_OLLAMA_HOST=http://127.0.0.1:11434
# Model used for embeddings (must match what brain.py uses)
SB_EMBEDDING_MODEL=nomic-embed-text
# Model used by /ask for answering
SB_CHAT_MODEL=llama3.1
# Context window sent to the embedding model
SB_EMBED_NUM_CTX=8192

# --- Vault ---
# Absolute path to your vault. Leave unset to use ~/SecondBrain.
# SB_VAULT_PATH=/home/you/SecondBrain
